# Application
NODE_ENV=development
PORT=3000

# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/multitenant_store?schema=public"

# JWT
JWT_ACCESS_SECRET=your-super-secret-access-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Resend (email)
RESEND_API_KEY=re_your_api_key
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_FROM_NAME=MultiTenant Store

# Frontend URL (for CORS) — comma-separated list allowed
FRONTEND_URL=http://localhost:8081,https://your-frontend-domain.com

# Base domain for tenant subdomain routing (e.g. store.midominio.com → tenant "store")
# Leave unset when using Railway or other platform URLs — subdomain extraction is disabled without this
# APP_DOMAIN=midominio.com

# Password reset link base. Use HTTPS for web testing or multitenant://reset-password for installed native apps.
PASSWORD_RESET_URL=https://your-frontend-domain.com/reset-password

# Team invitation link base. Use HTTPS for web testing or multitenant://invite for installed native apps.
TEAM_INVITE_URL=https://your-frontend-domain.com/invite

# Yappy Payment
# YAPPY_MOCK=true skips real API calls — use in development/testing
YAPPY_MERCHANT_ID=your_merchant_id
YAPPY_SECRET_KEY=your_base64_encoded_secret
YAPPY_URL_DOMAIN=yourdomain.com
YAPPY_API_URL=https://api.multired.com.pa
YAPPY_SITE_URL=https://your-backend.com
YAPPY_MOCK=true

# Superadmin seed credentials (used by prisma/seed.ts only)
SEED_SUPERADMIN_EMAIL=superadmin@example.com
SEED_SUPERADMIN_PASSWORD=SuperSecure123!
